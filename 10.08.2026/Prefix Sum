  class Solution:
    def checkSubarraySum(self, nums: List[int], k: int) -> bool:
        prefix_sum = 0 
        dic = {0:-1} 
        for i in range(len(nums)):
            prefix_sum += nums[i] 
            
            remainder = prefix_sum % k 

            if remainder in dic:
                if i - dic[remainder] >= 2:
                    return True 
            else:
                dic[remainder] = i 
        
        return False
