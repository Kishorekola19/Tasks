  class Solution:
    def subarraySum(self, nums: List[int], k: int) -> int:
        sum=0 
        count=0 
        dic={0:1} 
        for ele in nums:
            sum+=ele 
            count+=dic.get(sum-k,0) 
            dic[sum]=dic.get(sum,0)+1 
        return count

