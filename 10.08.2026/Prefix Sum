  class Solution:
    def findMiddleIndex(self, nums: List[int]) -> int:
        n=len(nums)
        total = sum(nums) 
        left = 0
        for i in range(n):
            right = total-left-nums[i] 
            if left==right:
                return i 
            left+=nums[i] 
        return -1

