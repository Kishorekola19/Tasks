  class Solution:
    def findMaxLength(self, nums: List[int]) -> int:
        n=len(nums)
        zero_count=0 
        one_count=0 
        max_length=0
        dic={0:-1}  
        for i in range(n):
            if nums[i]==1:
                one_count+=1 
            else:
                zero_count+=1 

            diff = one_count-zero_count 

            if diff in dic:
                max_length = max(max_length,i-dic[diff]) 
            else:
                dic[diff] = i 

        return max_length

