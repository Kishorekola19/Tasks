  class Solution:
    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:
        rows = len(matrix) 
        cols = len(matrix[0]) 

        low=0 
        high=rows*cols-1 

        while low<=high:
            mid = (low+high)//2 

            row = mid//cols 
            col = mid%cols 

            if matrix[row][col] == target:
                return True 
            elif matrix[row][col] < target:
                low=mid+1 
            else:
                high=mid-1 
        
        return False

Leetcode - 875:

  class Solution:
    def minEatingSpeed(self, piles: List[int], h: int) -> int:
        low=1 
        high = max(piles) 
        res=high 
        while low<=high:
            mid = low + (high-low)//2 
            time = 0
            for i in piles:
                if i<=mid:
                    time+=1 
                    continue
                if i%mid == 0:
                    time += (i//mid) 
                else:
                    time += (i//mid) + 1 
            if time<=h:
                res=mid 
                high = mid-1 
            else:
                low=mid+1 
        
        return res



        
