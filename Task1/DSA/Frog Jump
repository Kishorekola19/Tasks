# 1. Frog Jump - Memorization

stone_count = int(input())
stone_heights = list(map(int, input().split()))
minimum_energy = [-1] * stone_count

def energy_to_reach(stone_index):
    if stone_index == 0:
        return 0

    if minimum_energy[stone_index] != -1:
        return minimum_energy[stone_index]

    one_step_cost = energy_to_reach(stone_index - 1) + abs(
        stone_heights[stone_index] - stone_heights[stone_index - 1]
    )

    two_step_cost = float("inf")
    if stone_index > 1:
        two_step_cost = energy_to_reach(stone_index - 2) + abs(
            stone_heights[stone_index] - stone_heights[stone_index - 2]
        )

    minimum_energy[stone_index] = min(one_step_cost, two_step_cost)
    return minimum_energy[stone_index]

print(energy_to_reach(stone_count - 1))


# 1. Frog Jump - Tabulation

stone_count = int(input())
stone_heights = list(map(int, input().split()))
minimum_energy = [0] * stone_count

minimum_energy[1] = abs(stone_heights[1] - stone_heights[0])

for current_stone in range(2, stone_count):
    one_step_cost = minimum_energy[current_stone - 1] + abs(
        stone_heights[current_stone] - stone_heights[current_stone - 1]
    )

    two_step_cost = minimum_energy[current_stone - 2] + abs(
        stone_heights[current_stone] - stone_heights[current_stone - 2]
    )

    minimum_energy[current_stone] = min(one_step_cost, two_step_cost)

print(minimum_energy[-1])


# 2. Frog Jump with K Distances - Memorization

stone_count, maximum_jump = map(int, input().split())
stone_heights = list(map(int, input().split()))
minimum_energy = [-1] * stone_count

def cheapest_path(current_stone):
    if current_stone == 0:
        return 0

    if minimum_energy[current_stone] != -1:
        return minimum_energy[current_stone]

    best_cost = float("inf")

    for jump_size in range(1, maximum_jump + 1):
        previous_stone = current_stone - jump_size

        if previous_stone >= 0:
            jump_cost = cheapest_path(previous_stone) + abs(
                stone_heights[current_stone] - stone_heights[previous_stone]
            )
            best_cost = min(best_cost, jump_cost)

    minimum_energy[current_stone] = best_cost
    return best_cost

print(cheapest_path(stone_count - 1))


